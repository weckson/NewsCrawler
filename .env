# ── Local mode (SQLite + filesystem) ──────────────────────────────────────────
# Leave DATABASE_URL empty to use SQLite automatically
DATABASE_URL=
SQLITE_DB_PATH=./data/crawler.db

# ── Object storage (local filesystem) ────────────────────────────────────────
OBJECT_STORE_BUCKET=./data/raw

# ── Benzinga API key (replace with your actual key) ──────────────────────────
BENZINGA_API_KEY=your_benzinga_api_key_here

# ── Alerting (optional) ──────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=

# ── Tuning ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_PORT=9090
