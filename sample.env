# ── Required ──────────────────────────────────────────────────────────────────
BENZINGA_API_KEY=your_benzinga_api_key_here
DATABASE_URL=postgresql://crawler:crawler@localhost:5432/newscrawler

# ── Object storage ────────────────────────────────────────────────────────────
# Set to a local path for dev (e.g. ./data/raw); set to an S3 bucket name for prod
OBJECT_STORE_BUCKET=./data/raw

# Optional: AWS credentials when using real S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-2
# AWS_ENDPOINT_URL=          # for MinIO / localstack

# ── Reuters/RDP (future adapter) ──────────────────────────────────────────────
# RDP_CLIENT_ID=
# RDP_USERNAME=
# RDP_PASSWORD=
# RDP_SCOPE=trapi.news.headlines.read

# ── Alerting webhooks ─────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# ALERT_EMAIL=

# ── Tuning ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_PORT=9090
